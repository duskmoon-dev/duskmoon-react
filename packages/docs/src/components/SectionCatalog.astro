---
import DocsLayout from "../layouts/DocsLayout.astro";
import DocsNavigation from "./DocsNavigation.astro";
import { getComponentDocs } from "../lib/component-docs";
import { DOC_CATEGORIES } from "../lib/docs-categories";
import { docsPath } from "../lib/paths";
import {
  categoriesForSection,
  sectionById,
  UTILITY_TOOLS,
  type DocSectionId,
} from "../lib/docs-sections";

const { section } = Astro.props as { section: DocSectionId };
const sectionTitle = sectionById(section).title;
const categories = categoriesForSection(section, getComponentDocs());
const docs = categories.flatMap(([, items]) => items);
const componentCount = docs.filter((item) => item.kind !== "infrastructure-export").length;
const apiCount = docs.length - componentCount;
---

<DocsLayout
  title={`${sectionTitle} Documentation`}
  description={`DuskMoon React ${sectionTitle} documentation with API references and demos.`}
  section={section}
>
  <div class="doc-shell catalog-shell" data-docs-browser>
    <DocsNavigation categories={categories} section={section} />
    <div class="doc-content">
      <section class="docs-hero">
        <h1>DuskMoon React {sectionTitle}</h1>
        <p>
          Browse {componentCount} components and {apiCount} API references in {sectionTitle}
          {section === "utilities" && ", plus the JSON Form guide and examples"}.
          Find usage demos, API details, and DuskMoon theme previews.
        </p>
        {section === "components" && <div class="docs-hero-actions">
          <a class="button-link" href={docsPath("/components/button")}>Start with Button</a>
          <a class="button-link" href={docsPath("/components/form")}>Form Component</a>
        </div>}
      </section>

      <p class="catalog-no-results" role="status" data-doc-catalog-empty hidden>
        No matching documentation. Clear the search to browse all entries.
      </p>
      {categories.map(([title, categoryDocs]) => {
        const category = DOC_CATEGORIES.find((item) => item.title === title)!;
        return (
          <section class="category" id={category.id} data-doc-category>
            <h2>{title}</h2>
            <p>{category.description} {categoryDocs.length} entries.</p>
            <div class="component-grid">
              {categoryDocs.map((component) => (
                <a
                  class="component-card"
                  href={component.route}
                  data-doc-card
                  data-search-text={`${component.title} ${component.id}`}
                >
                  <strong>
                    {component.title}
                    {component.kind === "dm-workflow-component" && (
                      <span class="dm-badge">Dm</span>
                    )}
                  </strong>
                  <span>{component.pageContent.summary || component.intro}</span>
                </a>
              ))}
            </div>
          </section>
        );
      })}
      {section === "utilities" && (
        <section class="category" id="tools" data-doc-category>
          <h2>JSON Form</h2>
          <p>Learn the supported JSON Schema fields, then open a preset to edit and submit it.</p>
          <div class="component-grid">
            {UTILITY_TOOLS.map((tool) => (
              <a
                class="component-card"
                href={docsPath(tool.path)}
                data-doc-card
                data-search-text={`${tool.title} ${tool.id}`}
              >
                <strong>{tool.title}</strong>
                <span>{tool.description}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</DocsLayout>
